# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Install Jenv
export PATH="$HOME/.jenv/bin:$PATH"
eval "$(jenv init -)"

export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

alias ll='ls -al'
alias k='kubectl'
alias docker=podman
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Install Goenv
export GOENV_ROOT="$HOME/.goenv"
export PATH="$GOENV_ROOT/bin:$PATH"
eval "$(goenv init -)"
#export PATH="$GOROOT/bin:$PATH"
#export PATH="$PATH:$GOPATH/bin"

export HISTSIZE=200


export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Hook Direnv
eval "$(direnv hook zsh)"

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# Sops default AGE Key
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"

# Kiro Path
export PATH="$HOME/.local/bin:$PATH"


# CloudConnectors AWS Profile Aliases
alias cciatadmin='cloudaccess sso --url "https://d-99671a01cd.awsapps.com/start/" -ro ServiceTeamAdmin -acc "db-systel-cloud-connectors-staging" --profile iat'
alias ccprodadmin='cloudaccess sso --url "https://d-99671a01cd.awsapps.com/start/" -ro ServiceTeamAdmin -acc "db-systel-cloud-connectors-production" --profile prod'
alias switchiat='export AWS_PROFILE=iat'
alias switchprod='export AWS_PROFILE=prod'

alias cciat='cloudaccess sso --url "https://d-99671a01cd.awsapps.com/start/" -ro ServiceTeamReader -acc "db-systel-cloud-connectors-staging" --profile cloudconnectors-iat-reader'
alias ccprod='cloudaccess sso --url "https://d-99671a01cd.awsapps.com/start/" -ro ServiceTeamReader -acc "db-systel-cloud-connectors-production" --profile cloudconnectors-prod-reader'

alias eksdev='aws eks update-kubeconfig --region eu-central-1 --name eks-dev-35 --profile cloudconnectors-iat-reader'
alias eksiat='aws eks update-kubeconfig --region eu-central-1 --name eks-iat-35 --profile cloudconnectors-iat-reader'
alias eksprod='aws eks update-kubeconfig --region eu-central-1 --name eks-prod-35 --profile cloudconnectors-prod-reader'

